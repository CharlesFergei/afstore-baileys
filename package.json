{
  "name": "@afstore/baileys",
  "version": "1.0.0",
  "description": "Custom WhatsApp WebSocket API Engine optimized for AF STORE Bot Ecosystem",
  "keywords": [
    "whatsapp",
    "websocket",
    "api",
    "nodejs",
    "baileys",
    "afstore",
    "wabot"
  ],
  "author": "Farel (AF STORE)",
  "license": "MIT",
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "exports": {
    ".": {
      "require": "./lib/index.cjs",
      "import": "./lib/index.js",
      "default": "./lib/index.cjs"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "lib/*",
    "WAProto/*",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CharlesFergei/afstore-baileys.git"
  },
  "homepage": "https://github.com/CharlesFergei/afstore-baileys#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@cacheable/node-cache": "*",
    "@hapi/boom": "*",
    "async-mutex": "*",
    "axios": "*",
    "cache-manager": "*",
    "curve25519-js": "*",
    "jimp": "^0.22.12",
    "lodash": "*",
    "lru-cache": "*",
    "moment-timezone": "*",
    "music-metadata": "*",
    "p-queue": "*",
    "pbjs": "^0.0.14",
    "pino": "*",
    "protobufjs": "*",
    "ws": "*"
  }
}
